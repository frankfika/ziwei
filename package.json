{
  "name": "ziwei-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "紫微助手 — 排盘引擎 + v4.0 解读数据集检索的最小可用产品",
  "workspaces": [
    "packages/*",
    "apps/*",
    "vendor/*"
  ],
  "scripts": {
    "typecheck": "bash scripts/typecheck.sh",
    "index:build": "tsx packages/reading-index/src/cli.ts",
    "chart": "tsx apps/cli/src/index.ts",
    "test": "tsx tests/run.ts",
    "web:dev": "npm run dev --workspace @ziwei/web",
    "web:build": "npm run build --workspace @ziwei/web",
    "acceptance": "bash scripts/acceptance.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
